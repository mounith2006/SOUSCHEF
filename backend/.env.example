# Local Whisper configuration

WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_SECONDS=120

# Frontend URL.
# For initial testing you can leave this as *.
FRONTEND_ORIGIN=*

# Rime TTS configuration
RIME_API_KEY=YOUR_ACTUAL_RIME_API_KEY
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL_ID=arcana
RIME_SPEAKER=astra
RIME_LANGUAGE=eng
RIME_TIMEOUT_SECONDS=30