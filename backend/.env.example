# Local Whisper configuration

WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_SECONDS=120
ACTIVE_LISTENING_TIMEOUT=20
SLEEP_WARNING_TIMEOUT=8

# Frontend URL.
# For initial testing you can leave this as *.
FRONTEND_ORIGIN=*

# Rime TTS configuration
RIME_API_KEY=
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL_ID=arcana
RIME_SPEAKER=astra
RIME_LANGUAGE=eng
RIME_TIMEOUT_SECONDS=30

# LLM configuration
LLM_PROVIDER=nvidia

# NVIDIA NIM
NVIDIA_API_KEY=PASTE_YOUR_KEY_HERE
NVIDIA_TIMEOUT_SECONDS=60

# NVIDIA model
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
